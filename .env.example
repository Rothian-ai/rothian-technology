# ---------------------------------------------------------------------------
# Contact form mail transport
# Copy to .env.local and fill in. Set the same keys in the Vercel project
# (Settings → Environment Variables) for Preview and Production.
#
# Pick ONE of the two transports below. The Entra/OAuth2 path wins whenever
# SMTP_TENANT_ID, SMTP_CLIENT_ID and SMTP_CLIENT_SECRET are all set, so leave
# those three EMPTY when using Resend — otherwise the Resend credentials are
# ignored and the send fails against Office 365 instead.
# ---------------------------------------------------------------------------

# ===========================================================================
# OPTION A — Resend (recommended)
# ===========================================================================
# The password is a Resend API key ("re_..."), and the username is the literal
# string `resend` — not your email address.
#
# Create the key at https://resend.com/api-keys with "Sending access".
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
# 465 is implicit TLS, so this must be true.
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=

# Leave these three empty for Resend — see the note at the top of the file.
SMTP_TENANT_ID=
SMTP_CLIENT_ID=
SMTP_CLIENT_SECRET=

# ===========================================================================
# OPTION B — Microsoft 365
# ===========================================================================
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false            # 587 is STARTTLS, not implicit TLS
#
# Preferred auth: an Entra ID app registration with the Office 365 Exchange
# Online `SMTP.SendAsApp` APPLICATION permission, admin consent granted, and
# the SMTP_FROM mailbox added to the app's Exchange access policy.
# SMTP_TENANT_ID=
# SMTP_CLIENT_ID=
# SMTP_CLIENT_SECRET=
#
# Fallback, only for tenants that still have SMTP AUTH enabled. SMTP_USER must
# be the licensed mailbox and SMTP_PASS an app password.
# SMTP_USER=
# SMTP_PASS=

# --- Addresses -------------------------------------------------------------
# The From: domain must be verified in whichever provider you chose, and must
# align with DMARC — rothian.com publishes p=quarantine, so an unaligned From:
# is silently quarantined rather than bounced.
#
# For Resend: verify rothian.com at https://resend.com/domains and add the DNS
# records it gives you. Its DKIM key is published at
# resend._domainkey.rothian.com and signs as d=rothian.com, which is what makes
# DMARC pass. The SPF record it asks for lives on the `send` subdomain, so your
# existing root SPF for Microsoft 365 does not need to change.
SMTP_FROM=website@rothian.com
SMTP_FROM_NAME=Rothian

# Where enquiries land. Defaults to SMTP_FROM if unset.
CONTACT_TO=info@rothian.com
# Optional second copy, comma-separated.
CONTACT_BCC=

# Per-brand inboxes. /api/contact is shared by the main site and the /digital,
# /cyber and /data sections; each posts its own `brand`. Set only the ones that
# need their own mailbox — anything unset falls back to CONTACT_TO.
# (/ui4ai is a landing page with no form, so it has no entry.)
CONTACT_TO_TECHNOLOGY=
CONTACT_TO_DIGITAL=
CONTACT_TO_CYBER=
CONTACT_TO_DATA=

# Send the enquirer an acknowledgement as well as notifying the team.
CONTACT_AUTOREPLY=false
