# ---------------------------------------------------------------------------
# Contact form → Microsoft 365 SMTP
# Copy to .env.local and fill in. Set the same keys in the Vercel project
# (Settings → Environment Variables) for Preview and Production.
# ---------------------------------------------------------------------------

# --- Transport -------------------------------------------------------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# 587 uses STARTTLS, so this stays false. Only set true for implicit TLS on 465.
SMTP_SECURE=false

# --- Auth: OAuth2 client credentials (preferred) ---------------------------
# Entra ID app registration with the Office 365 Exchange Online
# `SMTP.SendAsApp` APPLICATION permission, granted admin consent, and the
# mailbox in SMTP_FROM added to the app's Exchange access policy.
SMTP_TENANT_ID=
SMTP_CLIENT_ID=
SMTP_CLIENT_SECRET=

# --- Auth: basic (fallback, only if SMTP AUTH is still enabled) -------------
# Ignored when the three SMTP_TENANT_ID/CLIENT_ID/CLIENT_SECRET values are set.
# SMTP_USER must be the licensed mailbox; SMTP_PASS an app password.
SMTP_USER=
SMTP_PASS=

# --- Addresses -------------------------------------------------------------
# Must be a mailbox on rothian.com — the domain publishes DMARC p=quarantine,
# so an unaligned From: is silently quarantined.
SMTP_FROM=website@rothian.com
SMTP_FROM_NAME=Rothian

# Where enquiries land. Defaults to SMTP_FROM if unset.
CONTACT_TO=info@rothian.com
# Optional second copy, comma-separated.
CONTACT_BCC=

# Per-brand inboxes. /api/contact is shared by the main site and the /digital,
# /cyber and /data sections; each posts its own `brand`. Set only the ones that
# need their own mailbox — anything unset falls back to CONTACT_TO above.
CONTACT_TO_TECHNOLOGY=
CONTACT_TO_DIGITAL=
CONTACT_TO_CYBER=
CONTACT_TO_DATA=

# Send the enquirer an acknowledgement as well as notifying the team.
CONTACT_AUTOREPLY=false
